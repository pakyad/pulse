rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── INSTITUTIONAL HELPERS (Optimized for evaluation limits) ──
    function isSignedIn() { return request.auth != null; }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@pulse.com' || 
        request.auth.token.email == 'official@pulse.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    // 🛡️ GLOBAL ADMIN OVERRIDE
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // ── USER PROFILES ──
    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    // ── MARKETPLACE ITEMS (Public Discovery) ──
    match /items/{itemId} {
      allow read: if isSignedIn() && (resource.data.status != 'FLAGGED_FOR_REVIEW' || isSuperAdmin());
      allow list: if isSignedIn(); // Rely on 'active' filters in the UI; direct reads are still protected.
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn(); 
    }

    // ── UNIFIED ORDERS & LOGISTICS ──
    match /orders/{orderId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn(); 
    }

    match /parent_orders/{orderId} {
      allow read, list: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── INSTITUTIONAL REGISTRIES (Public Read, Admin Write) ──
    match /PriceGuidelines/{id} { allow read, list: if true; allow write: if isSuperAdmin(); }
    match /announcements/{id} { allow read, list: if true; allow write: if isSuperAdmin(); }
    match /facilities/{id} { allow read, list: if true; allow write: if isSuperAdmin(); }
    match /events/{id} { allow read, list: if true; allow write: if isSuperAdmin(); }
    match /vitals/{id} { allow read, list: if true; allow write: if isSuperAdmin(); }
    match /campaigns/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /pulse_posts/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    
    // ── TRANSACTIONS & REVIEWS ──
    match /transactions/{id} { 
      allow read, list: if isSignedIn(); 
      allow create: if isSignedIn();
    }

    match /Reviews/{id} {
      allow read, list: if true;
      allow create: if isSignedIn();
    }

    match /bookings/{id} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // ── LEGACY & EXTENSIONS ──
    match /delivery_jobs/{id} { 
      allow read, list: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /disputes/{id} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    match /appeals/{id} {
      allow read, list, write: if isSignedIn();
    }

    match /governance_logs/{id} {
      allow read, list, write: if isSignedIn();
    }

    // ── PRICE REPORTS (Community Flagging System) ──
    // Any signed-in user can submit a report.
    // Only admins can read the full list (for review queue).
    match /price_reports/{id} {
      allow create: if isSignedIn();
      allow read, list: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }
  }
}
