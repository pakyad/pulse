rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── INSTITUTIONAL HELPERS ──
    function isSignedIn() { return request.auth != null; }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@pulse.edu' || 
        request.auth.token.email == 'official@pulse.edu' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    // 🛡️ GLOBAL ADMIN OVERRIDE
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // ── CAMPUS RADAR (LOST & FOUND) ──
    // Moved to top for precedence and simplified
    match /campus_radar/{id} {
      allow read, list, write: if isSignedIn();
    }

    // ── USER DATA ──
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId);
      allow read: if isSignedIn();
    }
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId);
    }

    // ── PAYOUT REQUESTS ──
    match /payout_requests/{id} {
      allow create: if isSignedIn();
      allow read, list: if isSignedIn() && (resource.data.user_id == request.auth.uid);
    }

    // ── MARKETPLACE ──
    match /items/{itemId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && request.auth.uid == resource.data.seller_id;
    }

    // ── ORDERS ──
    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read, list, update: if isSignedIn() && (
        request.auth.uid == resource.data.buyer_id || 
        request.auth.uid == resource.data.seller_id || 
        request.auth.uid == resource.data.runner_id ||
        resource.data.status == 'PENDING_RUNNER'
      );
    }

    // ── OTHER COLLECTIONS ──
    match /announcements/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /PriceGuidelines/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /facilities/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /events/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /vitals/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /campaigns/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /pulse_posts/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /notifications/{id} { 
      allow read, list, write: if isSignedIn() && (
        resource == null || request.auth.uid == resource.data.user_id
      ); 
    }
    match /chats/{id} { allow read, list, write: if isSignedIn(); }
    match /messages/{id} { allow read, list, write: if isSignedIn(); }
    match /Reviews/{id} { allow read, list: if true; allow create: if isSignedIn(); }
    match /bookings/{id} { allow read, list, write: if isSignedIn(); }
    match /disputes/{id} { allow read, list, write: if isSignedIn(); }
    match /appeals/{id} { allow read, list, write: if isSignedIn(); }
    match /price_reports/{id} { allow read, list, write: if isSignedIn(); }
  }
}
