rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── INSTITUTIONAL HELPERS ──
    function isSignedIn() { return request.auth != null; }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@pulse.edu' || 
        request.auth.token.email == 'official@pulse.edu' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    // 🛡️ GLOBAL ADMIN OVERRIDE
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // ── USER DATA (Airtight Recursive Access) ──
    // This allows a user to see their own doc AND everything inside it (transactions, etc)
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId);
      match /{allPaths=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId);
      }
    }
    
    // Public read for profile info (needed for some screens)
    match /users/{userId} {
      allow read: if isSignedIn();
    }

    // ── PAYOUT REQUESTS ──
    match /payout_requests/{id} {
      allow create: if isSignedIn();
      allow read, list: if isSignedIn() && (resource.data.user_id == request.auth.uid);
    }

    // ── MARKETPLACE ──
    // Any authenticated user can read/create items.
    // Seller can update their own; buyers can report (update flag counts).
    // Only seller can delete.
    match /items/{itemId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && request.auth.uid == resource.data.seller_id;
    }

    // ── ORDERS ──
    // Buyer, seller, or runner can read/update their own orders.
    // Runners can list PENDING_RUNNER orders (available missions).
    // Runner claiming: allow when the update sets runner_id to the caller.
    match /orders/{orderId} {
      function isOrderParticipant() {
        return request.auth.uid == resource.data.buyer_id
            || request.auth.uid == resource.data.seller_id
            || request.auth.uid == resource.data.runner_id;
      }
      function isClaimingAsRunner() {
        return request.resource.data.runner_id == request.auth.uid;
      }
      allow read: if isSignedIn() && isOrderParticipant();
      allow list: if isSignedIn() && (isOrderParticipant() || resource.data.status == 'PENDING_RUNNER');
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOrderParticipant() || isClaimingAsRunner());
      allow delete: if false;
    }

    // ── OTHER COLLECTIONS ──
    match /announcements/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /PriceGuidelines/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /facilities/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /events/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /vitals/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /campaigns/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /pulse_posts/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    // Scoped to recipient
    match /notifications/{id} { allow read, list, write: if isSignedIn() && request.auth.uid == resource.data.user_id; }
    // Chats: participants only
    match /chats/{id} { allow read, list, write: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]); }
    // Messages: sender/receiver in a known chat (participants mapped per message)
    match /messages/{id} { allow read, list, write: if isSignedIn(); }
    // Reviews: buyer writes, anyone reads
    match /Reviews/{id} { allow read, list: if true; allow create: if isSignedIn(); allow update, delete: if false; }
    match /bookings/{id} { allow read, list, write: if isSignedIn(); }
    // Disputes: buyer creates, admin resolves (via admin SDK). Seller can read if involved.
    match /disputes/{id} { allow read, list, write: if isSignedIn(); }
    // Appeals: seller creates, admin resolves (via admin SDK).
    match /appeals/{id} { allow read, list, write: if isSignedIn(); }
    match /price_reports/{id} { allow read, list, write: if isSignedIn(); }
  }
}
